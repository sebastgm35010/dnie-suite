<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <!-- Only public signed CA/CRL downloads; no identities or documents. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">ocsp.reniec.gob.pe</domain>
        <domain includeSubdomains="false">www.reniec.gob.pe</domain>
        <domain includeSubdomains="false">crl.reniec.gob.pe</domain>
        <domain includeSubdomains="false">crl2.reniec.gob.pe</domain>
    </domain-config>
</network-security-config>
